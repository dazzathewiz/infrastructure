#!/bin/bash

# Run the Pi-hole v6 Teleporter export inside the container. `pihole -a -t`
# was removed in v6 (https://github.com/pi-hole/pi-hole/issues/5928); the
# replacement lives in pihole-FTL, writes the archive into its working
# directory, and prints the filename it created to stdout.
backup_dir="{{ docker_dir }}/{{ container_name }}/backup"

teleporter_output="$(docker exec -w /backup {{ container_name }} pihole-FTL --teleporter 2>&1)"
teleporter_status=$?
archive_name="$(echo "${teleporter_output}" | grep -oE '[^[:space:]]+\.zip' | tail -n1)"

if [ ${teleporter_status} -ne 0 ] || [ -z "${archive_name}" ] || [ ! -s "${backup_dir}/${archive_name}" ]; then
    logger -t pihole-backup "Teleporter backup FAILED (exit ${teleporter_status}): ${teleporter_output}"
    exit 1
fi

logger -t pihole-backup "Teleporter backup OK: ${archive_name}"

# Delete all but the newest {{ pihole_backup_retension }} archives, run inside
# the container since /backup is owned root:root by the container and the
# connecting user cannot remove files there directly.
# - https://www.ostechnix.com/find-delete-oldest-file-x-files-directory/
# Mixed .tar.gz (pre-v6) / .zip (v6+) archives sort fine together by mtime.
prune_output="$(docker exec {{ container_name }} sh -c 'cd /backup && ls -1t | tail -n +{{ pihole_backup_retension + 1 }} | xargs -r rm' 2>&1)"
prune_status=$?

if [ ${prune_status} -ne 0 ]; then
    logger -t pihole-backup "Teleporter prune WARNING (exit ${prune_status}): ${prune_output}"
fi

exit 0
